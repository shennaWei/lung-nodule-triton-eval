# Stage-2 false-positive reducer (3D ResNet-18, 48^3 crops, ONNX Runtime backend).
#
# Batch is sized for candidate scoring: one scan yields <= 64 candidates after
# NMS, so 32 is a good compromise between latency and GPU utilisation.
name: "stage2_fp_reducer"
platform: "onnxruntime_onnx"
max_batch_size: 32
default_model_filename: "model.onnx"

input [
  {
    name: "crop"
    data_type: TYPE_FP32
    dims: [ 2, 48, 48, 48 ]
  }
]

output [
  {
    name: "logit"
    data_type: TYPE_FP32
    dims: [ 1 ]
  },
  {
    name: "diameter"
    data_type: TYPE_FP32
    dims: [ 1 ]
  }
]

instance_group [
  {
    kind: KIND_GPU
    count: 1
  }
]

dynamic_batching {
  preferred_batch_size: [ 8, 16, 32 ]
  max_queue_delay_microseconds: 1000
}

parameters [
  { key: "cudnn_conv_algo_search" value: { string_value: "HEURISTIC" } },
  { key: "intra_op_thread_count" value: { string_value: "1" } }
]

version_policy {
  latest {
    num_versions: 1
  }
}
